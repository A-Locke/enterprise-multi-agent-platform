# azd environment (contains local env state; never commit)
.azure/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
dist/
build/

# Power Platform CLI
.pac/

# Editors / OS
.vscode/
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json

# Secrets — never commit real values
*.env
!.env.example

# Generated from power-platform/solutions/connectors/*/*.template.json -- contains real
# client IDs/tenant ID/APIM hostname. Templates (*.template.json) are committed; these
# generated files are not.
power-platform/solutions/connectors/*/apiDefinition.json
power-platform/solutions/connectors/*/apiProperties.json
power-platform/solutions/connectors/*/settings.json

# Generated by scripts/deploy-business-data-solution.ps1 -- packed zip built from the
# source-controlled power-platform/solutions/business-data/ folder, not itself the source.
power-platform/solutions/business-data/_build/
