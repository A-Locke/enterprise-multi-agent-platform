# Local environment configuration template.
# Copy to `.env` and fill in real values — `.env` is gitignored and must never be committed.
# This is the single source of truth for local config; `scripts/load-env.ps1` loads it into
# the current PowerShell session so `az`/`azd`/`pac` pick up the ${VAR} references used in
# infra/main.parameters.json.

# --- Azure account (from the portal, see manual-setup.md #1-2) ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# --- azd environment (drives infra/main.parameters.json) ---
AZURE_ENV_NAME=dev
AZURE_LOCATION=

# --- API Management developer portal contact (Bicep param, no hardcoded default) ---
APIM_PUBLISHER_EMAIL=
APIM_PUBLISHER_NAME=

# --- Cost Management budget alert recipient (Bicep param, no hardcoded default) ---
BUDGET_NOTIFICATION_EMAIL=

# --- Power Platform: same tenant as Azure, via a new organizational user (see ADR-0004) ---
POWER_PLATFORM_ADMIN_UPN=
POWER_PLATFORM_ENVIRONMENT_URL=

# --- Entra ID app registration protecting the platform API (Milestone 1, infra/entra/) ---
# Created/reused by scripts/setup-entra-app.ps1
AZURE_API_APP_CLIENT_ID=

# --- Milestone 2: local dev principal for Azure OpenAI RBAC (az ad signed-in-user show) ---
LOCAL_DEV_PRINCIPAL_ID=

# --- Milestone 2: azd's own convention for `azd deploy` -- not a custom Bicep param, azd
# looks for this exact name. Same value as the ACR_LOGIN_SERVER Bicep output; duplicated
# here because azd's deploy tooling doesn't read arbitrary Bicep outputs for this. ---
AZURE_CONTAINER_REGISTRY_ENDPOINT=

# Additional app-level secrets (Azure OpenAI/AI Foundry endpoint, connection strings, etc.)
# are added here as each milestone introduces the corresponding service — never hardcoded
# into apps/* source.
