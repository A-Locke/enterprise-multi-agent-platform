# Local environment configuration template.
# Copy to `.env` and fill in real values — `.env` is gitignored and must never be committed.
# This is the single source of truth for local config; `scripts/load-env.ps1` loads it into
# the current PowerShell session so `az`/`azd`/`pac` pick up the ${VAR} references used in
# infra/main.parameters.json.

# --- Azure account (from the portal, see manual-setup.md #1-2) ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# --- azd environment (drives infra/main.parameters.json) ---
AZURE_ENV_NAME=dev
AZURE_LOCATION=

# --- API Management developer portal contact (Bicep param, no hardcoded default) ---
APIM_PUBLISHER_EMAIL=
APIM_PUBLISHER_NAME=

# --- Cost Management budget alert recipient (Bicep param, no hardcoded default) ---
BUDGET_NOTIFICATION_EMAIL=

# --- Power Platform: same tenant as Azure, via a new organizational user (see ADR-0004) ---
POWER_PLATFORM_ADMIN_UPN=
POWER_PLATFORM_ENVIRONMENT_URL=

# --- Entra ID app registration protecting the platform API (Milestone 1, infra/entra/) ---
# Created/reused by scripts/setup-entra-app.ps1
AZURE_API_APP_CLIENT_ID=

# --- Milestone 2: local dev principal for Azure OpenAI RBAC (az ad signed-in-user show) ---
LOCAL_DEV_PRINCIPAL_ID=

# --- Milestone 2: azd's own convention for `azd deploy` -- not a custom Bicep param, azd
# looks for this exact name. Same value as the ACR_LOGIN_SERVER Bicep output; duplicated
# here because azd's deploy tooling doesn't read arbitrary Bicep outputs for this. ---
AZURE_CONTAINER_REGISTRY_ENDPOINT=

# --- Milestone 3: Copilot Studio connector's own OAuth redirect URI. Power Platform
# generates one per connector (a fixed suffix derived from the connector, stable across
# updates per Microsoft's docs) -- copy it from the connector's Security tab (or a failed
# sign-in's AADSTS50011 error, which echoes it back) and register it as a reply URL on the
# app registration via scripts/setup-entra-app.ps1. ---
COPILOT_CONNECTOR_REDIRECT_URI=

# --- Milestone 9: client ID of the User-Assigned Managed Identity `azd pipeline config`
# created for GitHub Actions OIDC federation (a separate resource group,
# rg-<project>-msi, that azd manages on its own -- not part of infra/main.bicep). Distinct
# from AZURE_API_APP_CLIENT_ID above; find it via `az identity list -g
# rg-enterprise-multi-agent-platform-msi` if lost. ---
AZURE_CLIENT_ID=

# --- Milestone 9: azd's own reserved env var for the "current principal id" it normally
# auto-resolves by looking up the interactively signed-in user via Microsoft Graph. That
# resolution path doesn't exist under federated/managed-identity CI auth (no signed-in user
# to look up), so the pipeline MSI's own object id (principalId, NOT clientId -- find via
# `az identity show -g rg-<project>-msi -n msi-<project> --query principalId`) must be
# supplied explicitly, or `azd provision` fails at "fetching current principal id". Not
# needed locally -- only set as a GitHub secret for the CI workflow. ---
AZURE_PRINCIPAL_ID=

# --- Milestone 9: dedicated Entra app registration (sp-<project>-pp-pipeline), registered as
# a Dataverse Application User (System Administrator) in both environments via
# `pac admin assign-user --application-user` -- see ADR-0013. Distinct from the Azure pipeline
# identity above; only used by power-platform-deploy.yml. Not needed locally. ---
POWER_PLATFORM_PIPELINE_CLIENT_ID=

# --- Milestone 9: the second, free Dataverse environment (Power Apps Developer Plan, same
# no-billing path as POWER_PLATFORM_ENVIRONMENT_URL above) that the Power Platform Build
# Tools pipeline promotes the business-data solution into. Not needed locally. ---
POWER_PLATFORM_TEST_ENVIRONMENT_URL=

# --- Post-Milestone-10: the Copilot Studio agent's custom connector embeds this (no scheme,
# e.g. apim-xxxxx.azure-api.net) in its exported connectionparameters/openapidefinition
# files -- redacted to a placeholder in power-platform/solutions/platform-api-connector and
# hydrated back at pack time in power-platform-deploy.yml. Same value as APIM_GATEWAY_URL
# (`azd env get-values`) with the scheme stripped. Not needed locally -- only set as a
# GitHub secret. See ADR-0015. ---
APIM_HOSTNAME=

# Additional app-level secrets (Azure OpenAI/AI Foundry endpoint, connection strings, etc.)
# are added here as each milestone introduces the corresponding service — never hardcoded
# into apps/* source.
